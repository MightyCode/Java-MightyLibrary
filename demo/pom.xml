<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.mightycode</groupId>
        <artifactId>mightylib-game-parent</artifactId>
        <version>1.1-SNAPSHOT</version>
        <relativePath>../game-parent/pom.xml</relativePath>
    </parent>

    <!-- The demo: an application of the library, built as a game is (mightylib-game-parent brings the natives of this
         machine, exec:java and the complete jar). Launched from the root of the repository, where it reads
         resources/. -->
    <artifactId>mightylib-demo</artifactId>

    <properties>
        <mightylib.mainClass>io.github.mightycode.mightylibdemo.main.Main</mightylib.mainClass>
        <!-- Profile analyse: the values of the engine (the demo does not inherit from the root pom, which explains this
             list) -->
        <mightylib.errorprone.args>-Xep:UnnecessaryParentheses:OFF -Xep:MissingSummary:OFF -Xep:EmptyBlockTag:OFF -Xep:InvalidLink:OFF -Xep:StringSplitter:OFF -Xep:InconsistentCapitalization:OFF -Xep:ReferenceEquality:OFF -Xep:EnumOrdinal:OFF</mightylib.errorprone.args>
        <mightylib.spotbugs.exclude>${maven.multiModuleProjectDirectory}/tools/spotbugs-exclude.xml</mightylib.spotbugs.exclude>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.mightycode</groupId>
            <artifactId>mightylib</artifactId>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
        </dependency>
        <dependency>
            <groupId>org.joml</groupId>
            <artifactId>joml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jbox2d</groupId>
            <artifactId>jbox2d-library</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-openal</artifactId>
        </dependency>

        <!-- Test helpers of the library (MainThreadTestAccess, WorkersTestAccess) -->
        <dependency>
            <groupId>io.github.mightycode</groupId>
            <artifactId>mightylib</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <arguments>
                        <argument>-f</argument>
                        <argument>false</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
