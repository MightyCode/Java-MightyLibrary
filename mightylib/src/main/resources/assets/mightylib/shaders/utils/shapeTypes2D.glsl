// Numbers of the vector shapes of the engine in the common batch program (aShapeType, shape2DBatchF.glsl): the same
// values as the Java class ShapeTypes (ShapeTypesTest checks them). 0: none, a shape out of the common program.
#define SHAPE_TYPE_NONE 0
#define SHAPE_TYPE_ROUNDED_RECTANGLE 1
#define SHAPE_TYPE_CIRCLE 2
#define SHAPE_TYPE_ELLIPSE 3
#define SHAPE_TYPE_TRIANGLE 4
#define SHAPE_TYPE_ARC 5
#define SHAPE_TYPE_REGULAR_POLYGON 6
#define SHAPE_TYPE_GRID 7
