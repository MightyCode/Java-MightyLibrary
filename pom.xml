<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.mightycode</groupId>
        <artifactId>mightylib-base-parent</artifactId>
        <version>1.1-SNAPSHOT</version>
        <relativePath>base-parent/pom.xml</relativePath>
    </parent>

    <!-- Aggregator, and parent of the library: the tooling of the engine's own development (coverage, compiler
         options of the engine module, values of the static analysis). The versions, the plugins and the profiles
         shared with the games come from mightylib-base-parent; the demo inherits from mightylib-game-parent, as a
         game does. -->
    <artifactId>mightylib-parent</artifactId>
    <packaging>pom</packaging>

    <modules>
        <module>bom</module>
        <module>base-parent</module>
        <module>game-parent</module>
        <module>mightylib</module>
        <module>demo</module>
    </modules>

    <properties>
        <jacoco.version>0.8.16</jacoco.version>
        <!-- Off: Javadoc and parentheses style (the project writes little Javadoc, and the IntelliJ analyzer already
             covers the style rules of bonnes-pratiques.md).
             StringSplitter: its fix is Guava's Splitter, the library stays without Guava.
             InconsistentCapitalization: the public fields of pure data structures start with an uppercase letter
             (WindowCreationInfo, BasicMaterial), their parameters do not.
             ReferenceEquality: identity is what the engine compares (owners, sentinels, the same data or element);
             String == stays checked by StringEquality.
             EnumOrdinal: arrays indexed by an enum (ConsoleLog) and enums whose order is a contract (ECommandLevel,
             EVerbosity). The demo repeats this list in its pom. -->
        <mightylib.errorprone.args>-Xep:UnnecessaryParentheses:OFF -Xep:MissingSummary:OFF -Xep:EmptyBlockTag:OFF -Xep:InvalidLink:OFF -Xep:StringSplitter:OFF -Xep:InconsistentCapitalization:OFF -Xep:ReferenceEquality:OFF -Xep:EnumOrdinal:OFF</mightylib.errorprone.args>
        <!-- From the root of the build (the library and the demo share the file) -->
        <mightylib.spotbugs.exclude>${maven.multiModuleProjectDirectory}/tools/spotbugs-exclude.xml</mightylib.spotbugs.exclude>
    </properties>

    <profiles>
        <!-- Code coverage of the unit tests, never part of the normal build:
             mvn -P coverage test -pl mightylib (see tools/coverage.py) -->
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>${jacoco.version}</version>
                        <configuration>
                            <!-- Code bound to OpenGL, OpenAL or GLFW (needs a window or a context, never unit tested):
                                 left out so the figures only show what a test could cover -->
                            <excludes>
                                <exclude>io/github/mightycode/mightylib/graphics/renderer/**</exclude>
                                <exclude>io/github/mightycode/mightylib/graphics/shader/**</exclude>
                                <exclude>io/github/mightycode/mightylib/graphics/surface/**</exclude>
                                <exclude>io/github/mightycode/mightylib/graphics/lighting/**</exclude>
                                <exclude>io/github/mightycode/mightylib/graphics/debug/**</exclude>
                                <exclude>io/github/mightycode/mightylib/graphics/utils/GenDeleteResources*</exclude>
                                <exclude>io/github/mightycode/mightylib/graphics/utils/Screenshot*</exclude>
                                <exclude>io/github/mightycode/mightylib/sounds/SoundManager*</exclude>
                                <exclude>io/github/mightycode/mightylib/sounds/SoundListener*</exclude>
                                <exclude>io/github/mightycode/mightylib/sounds/SoundSource.*</exclude>
                                <exclude>io/github/mightycode/mightylib/main/monitors/**</exclude>
                            </excludes>
                        </configuration>
                        <executions>
                            <execution>
                                <id>jacoco-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>jacoco-report</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Appended to the options of the profile analyse of mightylib-base-parent -->
                    <compilerArgs combine.children="append">
                        <!-- Off, accepted: some public members of exported types expose a type of an internal
                             package (Engine.consoleLog, Window.getGLContext, GLResources.shared...: docs/decisions.md);
                             removing them needs an internal gateway (docs/later.md). The alert also hides a type of
                             another module exposed without "requires transitive": when a dependency enters the API,
                             compile once with -Xlint:exports and compare with the list of docs/later.md -->
                        <arg>-Xlint:-exports</arg>
                        <!-- Off, accepted: JBox2D, JLayer and OpenSimplex have no module name, the engine requires
                             them as automatic modules named after their jar -->
                        <arg>-Xlint:-requires-automatic</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
