<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs patterns the project accepts on purpose; every entry says why. Run through tools/analyse.py. -->
<FindBugsFilter>
    <!-- Getters and constructors of a game engine hand out mutable vectors, colors and arrays on purpose
         (copying them on every call would cost more than the protection brings). -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,MS_EXPOSE_REP"/>
    </Match>
    <!-- The engine's static utilities use PascalCase (GenDeleteResources.GenBuffers, Logger.LogException). -->
    <Match>
        <Bug pattern="NM_METHOD_NAMING_CONVENTION,NM_FIELD_NAMING_CONVENTION"/>
    </Match>
    <!-- Volatile counters with a single writer thread, read by other threads: the increment needs no atomic
         operation (comment at each increment). -->
    <Match>
        <Or>
            <And><Class name="io.github.mightycode.mightylib.resources.DataType"/><Field name="version"/></And>
            <And><Class name="io.github.mightycode.mightylib.resources.ResourceWatcher"/><Field name="reloadCount"/></And>
        </Or>
        <Bug pattern="VO_VOLATILE_INCREMENT,AT_NONATOMIC_OPERATIONS_ON_SHARED_VARIABLE"/>
    </Match>
</FindBugsFilter>
