<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs patterns the project accepts on purpose; every entry says why. Run through tools/analyse.py. -->
<FindBugsFilter>
    <!-- Getters and constructors of a game engine hand out mutable vectors, colors and arrays on purpose
         (copying them on every call would cost more than the protection brings). -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,MS_EXPOSE_REP"/>
    </Match>
    <!-- The engine's static utilities use PascalCase (GenDeleteResources.GenBuffers, Logger.LogException). -->
    <Match>
        <Bug pattern="NM_METHOD_NAMING_CONVENTION,NM_FIELD_NAMING_CONVENTION"/>
    </Match>
    <!-- Volatile counters with a single writer thread, read by other threads: the increment needs no atomic
         operation (comment at each increment). -->
    <Match>
        <Or>
            <And><Class name="io.github.mightycode.mightylib.resources.DataType"/><Field name="version"/></And>
            <And><Class name="io.github.mightycode.mightylib.resources.ResourceWatcher"/><Field name="reloadCount"/></And>
        </Or>
        <Bug pattern="VO_VOLATILE_INCREMENT,AT_NONATOMIC_OPERATIONS_ON_SHARED_VARIABLE"/>
    </Match>
    <!-- A TestEngine is driven by the thread that started it only (its Javadoc): its fields are not shared. -->
    <Match>
        <Class name="io.github.mightycode.mightylib.test.TestEngine"/>
        <Bug pattern="AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
    </Match>
    <!-- The fields of a Java Flight Recorder event are read by JFR (reflection) when it is committed. -->
    <Match>
        <Class name="io.github.mightycode.mightylib.graphics.renderer._2D.batch.internal.BatchSendEvent"/>
        <Bug pattern="URF_UNREAD_FIELD"/>
    </Match>
    <!-- Public fields of pure data structures (decisions.md, guarded by PublicFieldsTest). -->
    <Match>
        <Bug pattern="PA_PUBLIC_PRIMITIVE_ATTRIBUTE"/>
    </Match>
    <!-- No finalizer, no security manager: a constructor that refuses its arguments can't be attacked through
         a subclass finalizer (finalization is deprecated since Java 18). -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <!-- The current GL context of the main thread is static on purpose: GL has one current context per thread and
         every context runs on the main thread. -->
    <Match>
        <Class name="io.github.mightycode.mightylib.graphics.internal.GLContext"/>
        <Field name="current"/>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    </Match>
    <!-- State changed and read on the main thread only (GL elements, resources, commands: CLAUDE.md); the
         detector takes them for shared because these classes also have synchronized or worker code. -->
    <Match>
        <Or>
            <Class name="io.github.mightycode.mightylib.graphics.GLElement"/>
            <Class name="io.github.mightycode.mightylib.scenes.camera.Camera"/>
            <And><Class name="io.github.mightycode.mightylib.resources.DataType"/><Field name="manuallyCreated"/></And>
            <And><Class name="io.github.mightycode.mightylib.utils.enginecommand.Commands"/><Or><Field name="tick"/><Field name="pluginCommandsFrozen"/></Or></And>
        </Or>
        <Bug pattern="AT_STALE_THREAD_WRITE_OF_PRIMITIVE,AT_NONATOMIC_OPERATIONS_ON_SHARED_VARIABLE"/>
    </Match>
    <!-- Written by the loader (worker) with the rest of what it read, before the resource is handed to the main
         thread, which orders the write; then changed and read on the main thread only. -->
    <Match>
        <Class name="io.github.mightycode.mightylib.resources.config.ConfigData"/>
        <Field name="invalidPlayerLayer"/>
        <Bug pattern="AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
    </Match>
    <!-- A test engine is driven from the thread that started it only (its Javadoc); the detector takes these flags
         for shared because the class also has atomic fields read by other threads. -->
    <Match>
        <Class name="io.github.mightycode.mightylib.test.TestEngine"/>
        <Or><Field name="strictResources"/><Field name="owner"/><Field name="closed"/></Or>
        <Bug pattern="AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
    </Match>
    <!-- FLAC samples have at most 24 bits (FlacStream refuses deeper files): side 25 bits, mid 26 bits, their sum
         can't overflow an int. -->
    <Match>
        <Class name="io.github.mightycode.mightylib.resources.sound.decoder.FlacStream"/>
        <Bug pattern="IM_AVERAGE_COMPUTATION_COULD_OVERFLOW"/>
    </Match>
    <!-- A future kept in a local named "ignored" says its result is not needed: Error Prone
         (FutureReturnValueIgnored) wants the value used, the variable is that use. -->
    <Match>
        <Bug pattern="DLS_DEAD_LOCAL_STORE"/>
        <Local name="ignored"/>
    </Match>
</FindBugsFilter>
